local function attr(inst, k)
    local ok, v = pcall(function() return inst:GetAttribute(k) end)
    if ok then return v end
end

local function new(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do inst[k] = v end
    return inst
end

local function prettyName(raw)
    return (raw:gsub("^%d+_", ""):gsub("_", " "))
end

local function isEgg(inst)
    if not inst:IsA("Model") then return false end
    if inst.Name == "Egg" then return true end
    if inst.Name:match("^Egg_") then return true end
    local ok, kind = pcall(function() return inst:GetAttribute("Kind") end)
    return ok and kind == "Egg"
end

local function countEggs(inst)
    local n = 0
    for _, d in ipairs(inst:GetDescendants()) do
        if isEgg(d) then n = n + 1 end
    end
    return n
end

local function biomeDistance(containers)
    local best = math.huge
    for _, c in ipairs(containers) do
        local pos
        if c:IsA("BasePart") then pos = c.Position
        elseif c:IsA("Model") then pcall(function() pos = c:GetPivot().Position end) end
        if not pos then
            for _, d in ipairs(c:GetDescendants()) do
                if d:IsA("BasePart") then pos = d.Position break end
            end
        end
        if pos then
            local dist = (pos - SPAWN).Magnitude
            if dist < best then best = dist end
        end
    end
    return best
end

local function discoverBiomes()
    local found, seen = {}, {}

    local function add(container)
        if not container or seen[container] then return end
        seen[container] = true
        local pretty = prettyName(container.Name)
        if pretty == "" then return end
        local count = countEggs(container)
        if count == 0 and not container.Name:match("^%d+_") then return end
        if not found[pretty] then
            found[pretty] = { Name = pretty, Containers = {}, EggCount = 0 }
        end
        table.insert(found[pretty].Containers, container)
        found[pretty].EggCount = found[pretty].EggCount + count
    end

    local map = workspace:FindFirstChild("Map")
    if map then
        for _, child in ipairs(map:GetChildren()) do
            if (child:IsA("Folder") or child:IsA("Model")) and child.Name:match("^%d+_") then
                add(child)
            end
            if child.Name == "BiomeNests" then
                for _, sub in ipairs(child:GetChildren()) do add(sub) end
            end
        end
    end

    local keywords = {
        "Forest","Swamp","Jungle","Desert","Ocean","Prehistoric",
        "Volcano","Haunted","Candy","Sky","Nether","Ice","Fire",
        "Space","Mythic","Heaven","Hell","Cave","Mountain","Beach",
    }
    for _, inst in ipairs(workspace:GetDescendants()) do
        if (inst:IsA("Folder") or inst:IsA("Model")) and countEggs(inst) > 0 then
            for _, kw in ipairs(keywords) do
                if inst.Name:lower():find(kw:lower(), 1, true) then
                    add(inst)
                    break
                end
            end
        end
    end

    local list = {}
    for _, b in pairs(found) do
        b.Distance = biomeDistance(b.Containers)
        table.insert(list, b)
    end
    table.sort(list, function(a, b) return a.Distance < b.Distance end)
    return list
end

local function scanBiomeContainers(containers)
    local eggs, seenEggs = {}, {}
    for _, container in ipairs(containers) do
        for _, d in ipairs(container:GetDescendants()) do
            if isEgg(d) and not seenEggs[d] then
                seenEggs[d] = true
                local pos
                pcall(function() pos = d:GetPivot().Position end)
                table.insert(eggs, {
                    Instance = d,
                    Nest     = d.Parent and d.Parent.Name or "?",
                    Rarity   = attr(d, "Rarity") or "?",
                    Species  = attr(d, "Species") or d.Name,
                    Mutation = attr(d, "BaseMutation") or "-",
                    Position = pos,
                    Key      = d:GetFullName(),
                })
            end
        end
    end
    table.sort(eggs, function(a, b)
        local ra, rb = RARITY_RANK[a.Rarity] or 0, RARITY_RANK[b.Rarity] or 0
        if ra ~= rb then return ra > rb end
        return a.Species < b.Species
    end)
    return eggs
end

local function teleportTo(pos)
    if not pos then return false end
    local char = Player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local targetCF = CFrame.new(pos + Vector3.new(0, 5, 0))
    pcall(function()
        char:PivotTo(targetCF)
    end)
    pcall(function()
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)
    return true
end

local function getRoot()
    local char = Player.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function firePrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return false end
    if not prompt.Enabled then return false end
    local success = false
    pcall(function()
        if fireproximityprompt then
            fireproximityprompt(prompt)
            success = true
        end
    end)
    if not success then
        pcall(function()
            prompt.HoldDuration = 0
            prompt:InputHoldBegin()
            task.wait(0.05)
            prompt:InputHoldEnd()
            success = true
        end)
    end
    return success
end

local function tryTouchPickup(part)
    if not part or not part:IsA("BasePart") then return end
    local root = getRoot()
    if not root then return end
    pcall(function()
        if firetouchinterest then
            firetouchinterest(part, root, 0)
            firetouchinterest(part, root, 1)
        end
    end)
end

local function eggStillExists(eggInstance)
    if not eggInstance then return false end
    local ok, parent = pcall(function() return eggInstance.Parent end)
    if not ok or not parent then return false end
    local stillThere = false
    pcall(function()
        stillThere = eggInstance:IsDescendantOf(workspace)
    end)
    return stillThere
end

local function attemptSteal(egg, timeout)
    timeout = timeout or 8
    local start = tick()
    while tick() - start < timeout do
        local promptFired = false
        for _, d in ipairs(egg.Instance:GetDescendants()) do
            if d:IsA("ProximityPrompt") then
                if firePrompt(d) then promptFired = true end
            end
        end
        if not promptFired and egg.Instance.Parent then
            for _, d in ipairs(egg.Instance.Parent:GetDescendants()) do
                if d:IsA("ProximityPrompt") then firePrompt(d) end
            end
        end
        for _, d in ipairs(egg.Instance:GetDescendants()) do
            if d:IsA("BasePart") then tryTouchPickup(d) end
        end
        task.wait(0.35)
        if not eggStillExists(egg.Instance) then return true end
        if attr(egg.Instance, "Collected") == true then return true end
    end
    return false
end

local function getSelectedTargets()
    local targets = {}
    for _, biome in ipairs(state.biomes) do
        if state.selectedZones[biome.Name] then
            local eggs = scanBiomeContainers(biome.Containers)
            for _, egg in ipairs(eggs) do
                if state.selectedRarities[egg.Rarity] then
                    egg.Biome = biome.Name
                    egg.BiomeDistance = biome.Distance
                    table.insert(targets, egg)
                end
            end
        end
    end
    table.sort(targets, function(a, b)
        if a.BiomeDistance ~= b.BiomeDistance then
            return a.BiomeDistance < b.BiomeDistance
        end
        local ra = RARITY_RANK[a.Rarity] or 0
        local rb = RARITY_RANK[b.Rarity] or 0
        return ra > rb
    end)
    return targets
end

