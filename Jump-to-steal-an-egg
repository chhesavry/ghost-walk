    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = espFolder

    espCache[eggInst] = { billboard = billboard, highlight = highlight }
end

local function updateESP()
    if not state.espEnabled then
        for eggInst, _ in pairs(espCache) do removeESP(eggInst) end
        return
    end
    if not SpeciesIconsLoaded then loadSpeciesIcons() end
    local liveEggs = {}
    for _, d in ipairs(workspace:GetDescendants()) do
        if isEgg(d) then
            liveEggs[d] = true
            if not espCache[d] then createESP(d) end
        end
    end
    for eggInst, _ in pairs(espCache) do
        if not liveEggs[eggInst] or not eggInst:IsDescendantOf(workspace) then
            removeESP(eggInst)
        end
    end
end

