task.spawn(function()
    while gui.Parent do
        task.wait(2)
        state.lastUpdate = tick()
        local newBiomes = discoverBiomes()
        local changed = #newBiomes ~= #state.biomes
        if not changed then
            for i, b in ipairs(newBiomes) do
                if not state.biomes[i] or state.biomes[i].Name ~= b.Name then
                    changed = true; break
                end
            end
        end
        if changed then
            state.biomes = newBiomes
            buildFilterPanel()
        else
            state.biomes = newBiomes
        end
        renderTargets()

        local targets = state.foundTargets
        statTargets.Text = tostring(#targets)
        statTargets.TextColor3 = #targets > 0 and C.Accent or C.Mute

        local zonesSelected = 0
        for _ in pairs(state.selectedZones) do zonesSelected = zonesSelected + 1 end
        statZones.Text = tostring(zonesSelected)

        local raritiesSelected = 0
        for _ in pairs(state.selectedRarities) do raritiesSelected = raritiesSelected + 1 end
        statRarities.Text = tostring(raritiesSelected)

        statStatus.Text = state.status
        if state.autoSteal then statStatus.TextColor3 = C.Accent
        elseif state.status:find("✗") then statStatus.TextColor3 = C.Danger
        elseif state.status:find("✓") then statStatus.TextColor3 = C.AutoOn
        else statStatus.TextColor3 = C.Sub end

        lastUpdateLbl.Text = string.format("Updated %.0fs ago", tick() - state.lastUpdate)
    end
end)

