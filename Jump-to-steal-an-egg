local function buildFilterPanel()
    for _, c in ipairs(filterScroll:GetChildren()) do
        if c:IsA("TextButton") or c:IsA("TextLabel") then c:Destroy() end
    end
    local order = 1
    makeSectionLabel("ZONES", order); order = order + 1
    for _, biome in ipairs(state.biomes) do
        local b = biome
        makeCheckRow(b.Name, order, state.selectedZones[b.Name] == true, C.Accent, function()
            state.selectedZones[b.Name] = not state.selectedZones[b.Name]
            return state.selectedZones[b.Name]
        end)
        order = order + 1
    end
    order = order + 1
    makeSectionLabel("RARITIES", order); order = order + 1
    for _, rarity in ipairs(ALL_RARITIES) do
        local r = rarity
        local color = RARITY_COLORS[r] or C.CheckOn
        makeCheckRow(r, order, state.selectedRarities[r] == true, color, function()
            state.selectedRarities[r] = not state.selectedRarities[r]
            return state.selectedRarities[r]
        end)
        order = order + 1
    end
end

