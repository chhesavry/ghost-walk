local function startAutoSteal()
    if state.autoLoop then return end
    state.autoLoop = task.spawn(function()
        while state.autoSteal do
            local targets = getSelectedTargets()
            if #targets == 0 then
                state.status = "No targets"
                task.wait(1)
            else
                for i, target in ipairs(targets) do
                    if not state.autoSteal then break end
                    state.currentTarget = target
                    state.status = string.format("→ %s (%d/%d)", target.Species, i, #targets)
                    teleportTo(target.Position)
                    task.wait(0.4)
                    state.status = "Stealing " .. target.Species .. "..."
                    local ok = attemptSteal(target, 8)
                    state.status = ok and ("✓ " .. target.Species) or ("✗ " .. target.Species)
                    teleportTo(SPAWN)
                    task.wait(2)
                end
                state.currentTarget = nil
            end
        end
    end)
end

local function stopAutoSteal()
    state.autoSteal = false
    state.autoLoop = nil
    state.currentTarget = nil
    state.status = "Ready"
    setAutoVisual(false)
end

